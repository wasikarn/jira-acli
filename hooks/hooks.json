{
  "description": "acli-guard: no acli or Atlassian MCP write from a subagent; main-thread writes prompt (blocks unattended runs). See hooks/acli-guard.py.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|Monitor|mcp__.*__ctx_(execute|execute_file|batch|batch_execute)|mcp__.*__execute(Read|Write|Destructive)?|mcp__.*([Aa][Tt][Ll][Aa][Ss][Ss][Ii][Aa][Nn]|[Jj][Ii][Rr][Aa]|[Cc][Oo][Nn][Ff][Ll][Uu][Ee][Nn][Cc][Ee]|[Bb][Ii][Tt][Bb][Uu][Cc][Kk][Ee][Tt]|[Jj][Ss][Mm]).*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/acli-guard.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
